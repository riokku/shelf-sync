{
  // Pure static-assets deployment — no Worker script/entry point needed,
  // Cloudflare serves dist/inventory-app directly. This is what the "Deploy
  // command: npx wrangler deploy" / "Version command: npx wrangler versions
  // upload" in the dashboard's Build configuration actually run against —
  // without this file there's nothing telling Wrangler what to deploy.
  //
  // "name" must match this project's name as already registered in the
  // Cloudflare dashboard (Workers & Pages) — check there if the first
  // deploy after adding this still fails with a name-mismatch error.
  "name": "shelf-sync",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "dist/inventory-app",
    // Client-side SPA with PathLocationStrategy routing (no hash URLs) —
    // this is the ONLY SPA-fallback mechanism to use on this product. A
    // src/_redirects file (the classic-Pages convention: /* /index.html
    // 200) was tried here first and rejected outright at deploy time —
    // "Invalid _redirects configuration: Infinite loop detected in this
    // rule" — Workers' loop-detection validator treats a catch-all
    // redirect as suspect in a way classic Pages never did. Don't add one
    // back; this config option is the real, supported answer for this
    // product.
    "not_found_handling": "single-page-application"
  }
}
